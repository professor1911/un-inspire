# MongoDB connection string.
# Local install:            mongodb://127.0.0.1:27017/ut-inspire
# MongoDB Atlas (cloud):    mongodb+srv://<user>:<password>@<cluster-url>/ut-inspire
MONGO_URI=mongodb://127.0.0.1:27017/ut-inspire

# Port the API server runs on
PORT=5000

# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Token required in the `x-admin-token` header to create/edit/delete content
# via the API or the frontend's /admin panel. Set this to a long random
# string before deploying anywhere public.
ADMIN_TOKEN=change-me-to-a-long-random-string
