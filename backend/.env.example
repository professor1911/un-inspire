# MongoDB connection string.
# Local install:            mongodb://127.0.0.1:27017/ut-inspire
# MongoDB Atlas (cloud):    mongodb+srv://<user>:<password>@<cluster-url>/ut-inspire
MONGO_URI=mongodb://127.0.0.1:27017/ut-inspire

# Port the API server runs on
PORT=5000

# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Token required in the `x-admin-token` header to create/edit/delete content
# via the API or the frontend's /admin panel. REQUIRED: if it is missing, all
# admin requests are refused. Use a long random string (32+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Only when the API runs behind a reverse proxy / load balancer: the number of
# proxy hops (usually 1). Needed so the per-IP rate limits see real visitor IPs.
# Leave unset when the API is reached directly.
# TRUST_PROXY=1
